# Copy to .env and fill in. .env is gitignored — never commit it.

# ── Pack source ───────────────────────────────────────────────────────────────
# packwiz-installer reads this on every container start, so whatever this points
# at IS what the server runs.
#
# PIN IT TO A TAG, not a branch. Scheduled restarts are unattended: pointed at
# a branch head, a 5:30am restart installs whatever was last pushed, including
# half-finished work. Tags are immutable, so restarts are reproducible and
# updating becomes a deliberate edit of this line.
#
# To update: change the tag below, then `docker compose up -d` -- NOT
# `restart`, which reuses the existing container with its old environment.
#
# Verify a tag before trusting it (a release once tagged the wrong commit):
#   git rev-parse v2.4.0 && git show $(git rev-parse v2.4.0):pack.toml | head -3
#
# Requires the repo to be public; see README.md if it ever goes private.
PACKWIZ_URL=https://raw.githubusercontent.com/wrenchInTheWorks/iron-and-arcana/v2.4.0/pack.toml

# ── Memory ────────────────────────────────────────────────────────────────────
# Java uses the heap PLUS ~1.3GB of its own (measured: 9.3GB resident for an 8G
# heap), and under load the heap grows to MAX_MEMORY and stays there. So:
#
#   MAX_MEMORY + 1.5G + everything else on the host  <=  RAM, without swap
#
# Swap is not headroom. A partly swapped heap shows up as 15-30s "Can't keep
# up!" stalls, and then the kernel's OOM killer SIGKILLs Java, which saves
# nothing. On a 15GiB host with a desktop session, MAX_MEMORY=12G was killed
# seven times in a day (2026-11-04). See README.md, "Memory".
INIT_MEMORY=2G
MAX_MEMORY=6G

# ── Performance ───────────────────────────────────────────────────────────────
# Quadratic: the server keeps (2v+1)^2 chunks per player, and generates all of
# them when a player explores -- 289 at 8, 625 at 12, 2401 at 24.
VIEW_DISTANCE=8
SIMULATION_DISTANCE=4

# ── Gameplay ──────────────────────────────────────────────────────────────────
MAX_PLAYERS=8
DIFFICULTY=normal

# World seed. Leave blank for a random one. Only takes effect when the world is
# FIRST generated - it will not change an existing world, so set it before the
# first start (or before deleting world/ to regenerate).
# Quote it if it is negative, e.g. SEED="-1234567890".
SEED=
MOTD=Iron & Arcana 2.0

# ── Access ────────────────────────────────────────────────────────────────────
# Comma-separated usernames or UUIDs. These replace hand-editing whitelist.json
# and ops.json on the server.
#
# These MERGE into the live files, they do not replace them. The image defaults
# EXISTING_WHITELIST_FILE to SYNC_FILE_MERGE_LIST, which for the WHITELIST
# variable normalises to MERGE -- read out of /image/scripts/start-setupRbac in
# itzg/minecraft-server:java17, verified 2026-10-11. So names added live (by the
# Discord bot, or `whitelist add` over RCON) survive every restart.
#
# Do NOT set OVERRIDE_WHITELIST=TRUE. It switches that to SYNCHRONIZE, which
# prunes anyone not listed here -- so every bot-added player would silently lose
# access at the next scheduled restart, which looks like a random overnight
# outage for them and is miserable to debug. Same applies to OVERRIDE_OPS.
ENABLE_WHITELIST=TRUE
WHITELIST=
OPS=

# Used only inside the container; the RCON port is not published.
RCON_PASSWORD=change-me

# ── Ports ─────────────────────────────────────────────────────────────────────
GAME_PORT=25565
BLUEMAP_PORT=8100

# ── Host ──────────────────────────────────────────────────────────────────────
TZ=Pacific/Auckland
