# Copy to .env and fill in. .env is gitignored — never commit it.

# ── Pack source ───────────────────────────────────────────────────────────────
# packwiz-installer reads this on every container start. Point it at the branch
# you want the server to track. Switch 2.0 -> main once 2.0 is merged.
# Requires the repo to be public; see README.md if it ever goes private.
PACKWIZ_URL=https://raw.githubusercontent.com/wrenchInTheWorks/iron-and-arcana/2.0/pack.toml

# ── Memory ────────────────────────────────────────────────────────────────────
# MAX_MEMORY should stay a little under the host's usable RAM. Metaspace for a
# pack this size runs ~480MB on top of the heap.
INIT_MEMORY=2G
MAX_MEMORY=6G

# ── Performance ───────────────────────────────────────────────────────────────
VIEW_DISTANCE=8
SIMULATION_DISTANCE=4

# ── Gameplay ──────────────────────────────────────────────────────────────────
MAX_PLAYERS=8
DIFFICULTY=normal
MOTD=Iron & Arcana 2.0

# ── Access ────────────────────────────────────────────────────────────────────
# Comma-separated usernames or UUIDs. These replace hand-editing whitelist.json
# and ops.json on the server.
ENABLE_WHITELIST=TRUE
WHITELIST=
OPS=

# Used only inside the container; the RCON port is not published.
RCON_PASSWORD=change-me

# ── Ports ─────────────────────────────────────────────────────────────────────
GAME_PORT=25565
BLUEMAP_PORT=8100

# ── Host ──────────────────────────────────────────────────────────────────────
TZ=Pacific/Auckland
